# Server
PORT=5050
NODE_ENV=development

# Database (SQLite)
DB_PATH=.
# Optional: path to better-sqlite3 native bindings if needed
# NATIVE_BINDINGS_PATH=

# R2 / S3-compatible storage
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Blossom public URL (used in upload responses)
BLOSSOM_PUBLIC_URL=https://blossom.smartflow.social

# Auth (Nostr signature tolerance in seconds)
# AUTH_TOLERANCE_SECONDS=300

# SmartFlowSocial internal API (subscription checks)
SFS_INTERNAL_URL=
SFS_INTERNAL_SECRET=
