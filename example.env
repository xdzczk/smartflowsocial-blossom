# Server
PORT=5050
NODE_ENV=development

# Database (SQLite)
DB_PATH=.
# Optional: path to better-sqlite3 native bindings if needed
# NATIVE_BINDINGS_PATH=

# R2 / S3-compatible storage
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Blossom public URL (used in upload responses)
BLOSSOM_PUBLIC_URL=https://blossom.smartflow.social

# Auth (Nostr signature tolerance in seconds)
# AUTH_TOLERANCE_SECONDS=300

# SmartFlowSocial internal API (subscription checks)
SFS_INTERNAL_URL=
SFS_INTERNAL_SECRET=
# Optional dedicated signing secret for upload tokens
# SFS_UPLOAD_TOKEN_SECRET=
# Optional explicit commit endpoint (defaults to ${SFS_INTERNAL_URL}/internal/blossom/commit-batch)
# SFS_COMMIT_BATCH_URL=
# SFS_COMMIT_BATCH_SIZE=20
# SFS_COMMIT_FLUSH_MS=2000
# SFS_COMMIT_MAX_ATTEMPTS=10
# Optional explicit policy endpoint (defaults to ${SFS_INTERNAL_URL}/internal/blossom/policy)
# SFS_POLICY_URL=
# SFS_POLICY_CACHE_TTL_SEC=90
# SFS_READINESS_MAX_PENDING_COMMITS=1000
# SFS_READINESS_MAX_DEAD_LETTER_COMMITS=0
# Compatibility lane (Blossom auth without X-SFS-Upload-Token)
# SFS_COMPAT_MODE_ENABLED=true
# SFS_COMPAT_MAX_UPLOAD_BYTES=52428800

# Rate limits (token bucket)
# RATE_LIMIT_MODE=local
# RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379
# RATE_LIMIT_REDIS_KEY_PREFIX=sfs:rl
# RATE_LIMIT_UPLOADS_BURST=20
# RATE_LIMIT_UPLOADS_PER_MIN=10
# RATE_LIMIT_BYTES_BURST=524288000
# RATE_LIMIT_BYTES_PER_MIN=209715200
# RATE_LIMIT_IP_UPLOADS_PER_MIN=120
# RATE_LIMIT_COMPAT_UPLOADS_BURST=10
# RATE_LIMIT_COMPAT_UPLOADS_PER_MIN=6
# RATE_LIMIT_COMPAT_BYTES_BURST=157286400
# RATE_LIMIT_COMPAT_BYTES_PER_MIN=62914560

# Metrics access is deny-by-default outside development/test.
# Configure one of:
# METRICS_TOKEN=...
# METRICS_ALLOWLIST=127.0.0.1,10.0.0.10
