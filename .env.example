# Server
PORT=5050

# R2
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto

# Public URL for Blossom url tag (no trailing slash)
BLOSSOM_PUBLIC_URL=https://blossom.smartflow.social

# SmartFlow subscription check
SFS_INTERNAL_URL=https://api.smartflow.social
SFS_INTERNAL_SECRET=

# Optional: Nostr auth clock tolerance (seconds)
AUTH_TOLERANCE_SECONDS=0

# Optional: SQLite DB directory (default: .)
DB_PATH=.
